<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.piedrazul.frontend.controller.AgendarCitaAutonomaController"
            stylesheets="@../css/dashboard.css"
            styleClass="dashboard-root"
            prefWidth="1200"
            prefHeight="720">

    <!-- BARRA SUPERIOR -->
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT">
            <Label text="PIEDRAZUL" styleClass="logo-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnVolver" text="Volver" onAction="#handleVolver" styleClass="logout-button"/>
        </HBox>
    </top>

    <!-- CONTENIDO -->
    <center>
        <VBox styleClass="dashboard-content" spacing="30" alignment="TOP_CENTER">

            <Label text="AGENDAR CITA" styleClass="title" />

            <GridPane hgap="20" vgap="20" alignment="CENTER">
                <Label text="Médico:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="label"/>
                <ComboBox fx:id="cmbMedicos" GridPane.rowIndex="0" GridPane.columnIndex="1"
                          prefWidth="300" styleClass="input"/>

                <Label text="Fecha:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="label"/>
                <DatePicker fx:id="dpFecha" GridPane.rowIndex="1" GridPane.columnIndex="1"
                            prefWidth="300" styleClass="input"/>
            </GridPane>

            <Label text="HORARIOS DISPONIBLES" styleClass="section-title"/>

            <TableView fx:id="tablaSlots" prefHeight="300" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colSlot" text="Horario" prefWidth="200"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <Button fx:id="btnAgendar" text="Agendar Cita" onAction="#handleAgendar"
                    styleClass="btn-primary" disable="true"/>

        </VBox>
    </center>

</BorderPane>