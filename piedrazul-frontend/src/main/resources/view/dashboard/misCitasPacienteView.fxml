<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.piedrazul.frontend.controller.MisCitasPacienteController"
            prefWidth="1100"
            prefHeight="650"
            style="-fx-background-color: #f1ebeb;">

        <top>
                <VBox spacing="12"
                      alignment="CENTER"
                      style="-fx-background-color: #24c0eb;">

                        <padding>
                                <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>

                        <Label text="MIS CITAS"
                               style="-fx-font-size: 28px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>

                        <Label fx:id="lblProximaCita"
                               text="Cargando citas..."
                               wrapText="true"
                               style="-fx-font-size: 16px;
                          -fx-text-fill: white;
                          -fx-font-weight: bold;"/>

                </VBox>
        </top>

        <center>
                <VBox spacing="10">

                        <padding>
                                <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>

                        <Label text="Historial de citas"
                               style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #37474f;"/>

                        <TableView fx:id="tablaCitas"
                                   VBox.vgrow="ALWAYS"
                                   style="-fx-background-radius: 12;
                              -fx-border-radius: 12;
                              -fx-border-color: #d0d0d0;
                              -fx-border-width: 1;
                              -fx-font-size: 13px;">

                                <columns>
                                        <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                                        <TableColumn fx:id="colFecha" text="Fecha" prefWidth="140"/>
                                        <TableColumn fx:id="colMedico" text="Médico" prefWidth="200"/>
                                        <TableColumn fx:id="colTipo" text="Tipo" prefWidth="100"/>
                                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
                                        <TableColumn fx:id="colMotivo" text="Motivo" prefWidth="280"/>
                                </columns>

                        </TableView>

                </VBox>
        </center>

        <bottom>
                <HBox alignment="CENTER_RIGHT"
                      spacing="10"
                      style="-fx-background-color: #f1ebeb;">

                        <padding>
                                <Insets top="15" right="15" bottom="15" left="15"/>
                        </padding>

                        <Button text="Volver"
                                fx:id="btnVolver"
                                onAction="#volver"
                                prefWidth="150"
                                prefHeight="45"
                                style="-fx-background-color: #ff5757;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-font-size: 14px;
                           -fx-background-radius: 10;
                           -fx-cursor: hand;"/>

                </HBox>
        </bottom>

</BorderPane>
