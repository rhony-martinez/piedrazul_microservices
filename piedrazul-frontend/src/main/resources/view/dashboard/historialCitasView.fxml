<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.piedrazul.frontend.controller.HistorialCitasController"
            styleClass="dashboard-root">

        <!-- ================= HEADER ================= -->
        <top>
                <VBox alignment="CENTER"
                      spacing="15"
                      styleClass="top-bar">

                        <padding>
                                <Insets top="20" right="30" bottom="20" left="30"/>
                        </padding>

                        <!-- TÍTULO -->
                        <Label text="HISTORIAL DE CITAS"
                               style="-fx-font-size: 28px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>

                        <!-- FILTROS -->
                        <HBox alignment="CENTER"
                              spacing="25">

                                <!-- MÉDICO -->
                                <VBox spacing="5">
                                        <Label text="Médico"
                                               style="-fx-text-fill: white;
                                  -fx-font-weight: bold;
                                  -fx-font-size: 16px;"/>
                                        <ComboBox fx:id="cmbMedicos"
                                                  prefWidth="260"/>
                                </VBox>

                                <!-- FECHA -->
                                <VBox spacing="5">
                                        <Label text="Fecha"
                                               style="-fx-text-fill: white;
                                  -fx-font-weight: bold;
                                  -fx-font-size: 16px;"/>
                                        <DatePicker fx:id="dpFecha"
                                                    prefWidth="220"
                                                    promptText="Seleccione fecha"/>
                                </VBox>

                                <!-- BOTÓN LISTAR -->
                                <VBox alignment="BOTTOM_CENTER">
                                        <Button text="LISTAR"
                                                onAction="#buscarCitas"
                                                prefWidth="180"
                                                prefHeight="55"
                                                style="-fx-background-color: #5cceee;
                                   -fx-text-fill: white;
                                   -fx-font-size: 20px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 10;
                                   -fx-border-radius: 10;
                                   -fx-border-color: #24c0eb;
                                   -fx-border-width: 2;
                                   -fx-cursor: hand;"/>
                                </VBox>

                        </HBox>

                </VBox>
        </top>

        <!-- ================= CENTRO ================= -->
        <center>
                <VBox spacing="15"
                      styleClass="dashboard-content">

                        <Label text="Resultados"
                               styleClass="welcome-label"/>

                        <TableView fx:id="tablaCitas"
                                   VBox.vgrow="ALWAYS"
                                   style="-fx-font-size: 14px;">

                                <columns>
                                        <TableColumn fx:id="colId" text="ID"/>
                                        <TableColumn fx:id="colFecha" text="Fecha"/>
                                        <TableColumn fx:id="colPaciente" text="Paciente"/>
                                        <TableColumn fx:id="colMedico" text="Médico"/>
                                        <TableColumn fx:id="colTipo" text="Tipo"/>
                                        <TableColumn fx:id="colEstado" text="Estado"/>
                                        <TableColumn fx:id="colMotivo" text="Motivo"/>
                                </columns>

                        </TableView>

                </VBox>
        </center>

        <!-- ================= FOOTER ================= -->
        <bottom>
                <HBox alignment="BOTTOM_RIGHT"
                      style="-fx-padding: 0 20 20 0;">

                        <Button text="Volver"
                                fx:id="btnVolver"
                                onAction="#volver"
                                styleClass="logout-button"
                                maxWidth="140"
                                prefWidth="140"
                                minWidth="140"
                                maxHeight="50"
                                prefHeight="50"
                                minHeight="50"
                                style="-fx-font-size: 14px;
                                -fx-font-weight: bold;"/>

                </HBox>
        </bottom>

</BorderPane>