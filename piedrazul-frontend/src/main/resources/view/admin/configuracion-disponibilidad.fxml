<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="18"
      alignment="TOP_CENTER"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.piedrazul.frontend.controller.ConfiguracionDisponibilidadController"
      stylesheets="@../css/admin.css"
      styleClass="root">

    <!-- ========================= -->
    <!-- CONFIGURACIÓN SISTEMA -->
    <!-- ========================= -->

    <VBox spacing="10"
          alignment="CENTER"
          styleClass="card">

        <Label text="Configuración del Sistema"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <HBox spacing="10" alignment="CENTER">

            <Label text="Semanas disponibles:"/>

            <TextField fx:id="txtSemanas"
                       promptText="Ej: 4"
                       prefWidth="100"/>

            <Button text="Guardar"
                    fx:id="btnGuardarConfiguracion"
                    onAction="#handleGuardarConfiguracion"/>

            <Button text="Editar"
                    fx:id="btnEditarConfiguracion"
                    onAction="#handleEditarConfiguracion"/>

        </HBox>

        <Label fx:id="lblEstadoConfiguracion"
               text="No configurado"
               style="-fx-text-fill: red; -fx-font-weight: bold;"/>

    </VBox>

    <!-- ========================= -->
    <!-- DISPONIBILIDAD -->
    <!-- ========================= -->

    <VBox fx:id="contenedorDisponibilidad"
          spacing="12"
          alignment="CENTER"
          styleClass="card">

        <Label text="Configurar Disponibilidad"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <ComboBox fx:id="cmbMedicos"
                  promptText="Seleccione médico"
                  prefWidth="250"/>

        <ComboBox fx:id="cmbDiaSemana"
                  promptText="Día"
                  prefWidth="250"/>

        <HBox spacing="20" alignment="CENTER">

            <VBox spacing="5">
                <Label text="Desde:" styleClass="field-label"/>
                <TextField fx:id="txtHoraInicio"
                           promptText="08:00"
                           styleClass="input-small"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Hasta:" styleClass="field-label"/>
                <TextField fx:id="txtHoraFin"
                           promptText="10:00"
                           styleClass="input-small"/>
            </VBox>

        </HBox>

        <TextField fx:id="txtIntervalo"
                   promptText="Intervalo (minutos)"
                   prefWidth="200"/>

        <Button text="Agregar Disponibilidad"
                onAction="#handleAgregar"/>

        <!-- TABLA -->
        <TableView fx:id="tablaDisponibilidad"
                   prefHeight="250"
                   prefWidth="750">

            <columns>
                <TableColumn fx:id="colMedico"
                             text="Médico"
                             prefWidth="180"/>

                <TableColumn fx:id="colDia"
                             text="Día"
                             prefWidth="120"/>

                <TableColumn fx:id="colHoraInicio"
                             text="Inicio"
                             prefWidth="100"/>

                <TableColumn fx:id="colHoraFin"
                             text="Fin"
                             prefWidth="100"/>

                <TableColumn fx:id="colIntervalo"
                             text="Intervalo"
                             prefWidth="100"/>
            </columns>

        </TableView>

    </VBox>

    <!-- BOTÓN VOLVER -->

    <Button text="Volver al Dashboard"
            onAction="#handleVolver"
            styleClass="dashboard-secondary-button"/>

</VBox>