# Copiar a .env y ajustar antes de: docker compose up -d --build
# cp .env.example .env

# Usuario de Docker Hub (sin barra final). Ejemplo: miusuario
DOCKERHUB_USER=piedrazul

# Etiqueta de imagen al publicar o consumir desde Docker Hub
IMAGE_TAG=latest

# PostgreSQL
POSTGRES_USER=piedrazul
POSTGRES_PASSWORD=db_piedrazul

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Keycloak Admin Console (http://localhost:8080/admin)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Secret del cliente piedrazul-admin-cli (debe coincidir con docker/keycloak/piedrazul-realm.json)
PIEDRAZUL_KEYCLOAK_ADMIN_CLIENT_SECRET=piedrazul-admin-secret

# Issuer publico para JWT (frontend en el host usa localhost)
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/piedrazul
